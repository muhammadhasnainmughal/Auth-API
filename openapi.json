{
  "openapi": "3.0.0",
  "info": {
    "title": "Supabase Auth API",
    "version": "1.0.0",
    "description": "API with Supabase Auth, protected routes, and JWT verification."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "Create a new user account",
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate & return a JWT",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/public/info": {
      "get": {
        "summary": "Read public data",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/protected/profile": {
      "get": {
        "summary": "Read private profile data",
        "security": [ { "bearerAuth": [] } ],
        "responses": { "200": { "description": "OK" }, "401": { "description": "Unauthorized" } }
      }
    },
    "/protected/dashboard": {
      "get": {
        "summary": "Read private dashboard data",
        "security": [ { "bearerAuth": [] } ],
        "responses": { "200": { "description": "OK" }, "401": { "description": "Unauthorized" } }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "End the user's session",
        "security": [ { "bearerAuth": [] } ],
        "responses": { "204": { "description": "No Content" } }
      }
    }
  }
}